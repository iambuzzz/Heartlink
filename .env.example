# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used in share links). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (service_role key stays on the server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Business UPI ID that receives payments, e.g. from PhonePe/Paytm/BharatPe for Business
UPI_VPA=
UPI_PAYEE_NAME=HeartLink

# Password for /admin, where you verify UTRs against your bank statement
ADMIN_PASSWORD=
